; DNS records for application: {{ app_config.metadata.name }}
; Owner: {{ app_config.metadata.owner }}
; Environment: {{ app_config.metadata.environment }}
; Generated by Ansible on {{ ansible_date_time.iso8601 | default('unknown') }}
{% for record in app_config.dns.records %}
{% if record.type == 'A' %}
; A record for {{ record.name }}.{{ app_config.dns.zone }}
{{ record.name }}    {{ record.ttl | default(300) }}    IN    A    {{ record.value }}
{% elif record.type == 'CNAME' %}
; CNAME record for {{ record.name }}.{{ app_config.dns.zone }}
{{ record.name }}    {{ record.ttl | default(300) }}    IN    CNAME    {{ record.value }}.
{% elif record.type == 'TXT' %}
; TXT record for {{ record.name }}.{{ app_config.dns.zone }}
{{ record.name }}    {{ record.ttl | default(300) }}    IN    TXT    "{{ record.value }}"
{% endif %}
{% endfor %}
