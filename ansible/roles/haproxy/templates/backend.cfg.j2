# HAProxy Configuration for: {{ app_config.metadata.name }}
# Owner: {{ app_config.metadata.owner }}
# Environment: {{ app_config.metadata.environment }}
# Generated by Ansible

# Frontend configuration for {{ app_config.haproxy.frontend.name }}
# Handles incoming HTTP requests and routes based on hostname
frontend {{ app_config.haproxy.frontend.name }}
    bind *:{{ app_config.haproxy.frontend.bind_port }}
    mode {{ app_config.haproxy.frontend.mode }}
    
    # ACL for hostname matching
    acl {{ app_config.haproxy.frontend.acl.name }} {{ app_config.haproxy.frontend.acl.match }}
    
    # Route to backend based on hostname
    use_backend {{ app_config.haproxy.backend.name }} if {{ app_config.haproxy.frontend.acl.name }}
    
    # Default backend (optional - uncomment if needed)
    # default_backend {{ app_config.haproxy.backend.name }}

# Backend configuration for {{ app_config.haproxy.backend.name }}
# Load balances traffic to K3s worker nodes
backend {{ app_config.haproxy.backend.name }}
    mode {{ app_config.haproxy.backend.mode }}
    balance {{ app_config.haproxy.backend.balance }}
    
{% if app_config.haproxy.backend.health_check.enabled | default(false) %}
    # Health check configuration
    option httpchk GET {{ app_config.haproxy.backend.health_check.path | default('/') }}
    http-check expect status 200
{% endif %}
    
    # Backend servers with health checks
{% for server in app_config.haproxy.backend.servers %}
    server {{ server.name }} {{ server.address }}:{{ server.port }} {{ server.options }}{% if app_config.haproxy.backend.health_check.enabled | default(false) %} inter {{ app_config.haproxy.backend.health_check.interval | default(5000) }} fall 3 rise 2{% endif %}

{% endfor %}
